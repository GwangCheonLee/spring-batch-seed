# BATCH DATABASE
BATCH_DATABASE_DRIVER=org.h2.Driver
BATCH_DATABASE_URL=jdbc:h2:mem:batch;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
BATCH_DATABASE_USERNAME=sa
BATCH_DATABASE_PASSWORD=
BATCH_DATABASE_HBM2DDL_AUTO=create-drop

# ANOTHER DATABASE
ANOTHER_DATABASE_DRIVER=org.h2.Driver
ANOTHER_DATABASE_URL=jdbc:h2:mem:another;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
ANOTHER_DATABASE_USERNAME=sa
ANOTHER_DATABASE_PASSWORD=
ANOTHER_DATABASE_HBM2DDL_AUTO=create-drop

# BATCH
CHUNK_SIZE=100
